<fieldset class="card items table">
    <legend>{{ localize "VARLYN5E.ADVANCEMENT.Migration.Selection" }}</legend>
    <div class="form-group hint">
        <p class="hint">{{ localize "VARLYN5E.ADVANCEMENT.Migration.Hint" name=item.name }}</p>
    </div>
    <div class="header">
        <div class="item-name">{{ localize "VARLYN5E.AdvancementTitle" }}</div>
        <div class="item-controls">{{ localize "VARLYN5E.Add" }}</div>
    </div>
    <ol class="items-list unlist">
        {{#each advancements}}
        <li class="advancement-item item flexrow">
            <div class="item-name flexrow">
                {{ varlyn5e-icon icon alt=title classes="gold-icon" }}
                <span class="name">{{ title }}</span>
            </div>
            <div class="item-controls flexrow">
                <varlyn5e-checkbox name="{{ id }}" checked></varlyn5e-checkbox>
            </div>
            {{#if summary}}
            <div class="item-summary">
                {{{ summary }}}
            </div>
            {{/if}}
        </li>
        {{/each}}
    </ol>
</fieldset>
